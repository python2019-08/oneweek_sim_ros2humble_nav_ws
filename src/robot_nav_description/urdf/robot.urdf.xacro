<?xml version="1.0"?>
<robot name="nav_robot" xmlns:xacro="shturl.cc/G4l5o2KMCIIv3uh9TSa">
  <!-- 全局参数开关：仿真时true，真机false -->
  <xacro:arg name="use_gazebo" default="false"/>

  <!-- ===================== 惯性宏定义 ===================== -->
  <xacro:macro name="inertial_box" params="mass w h d">
    <inertial>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass*(h*h + d*d)/12.0}"
        iyy="${mass*(w*w + d*d)/12.0}"
        izz="${mass*(w*w + h*h)/12.0}"
        ixy="0.0" 
        ixz="0.0" 
        iyz="0.0"
        />
    </inertial>
  </xacro:macro>

  <xacro:macro name="inertial_cylinder" params="mass r l">
    <inertial>
      <mass value="${mass}"/>
      <inertia
        ixx="${0.5*mass*r*r}"
        iyy="${mass*(3*r*r + l*l)/12.0}"
        izz="${mass*(3*r*r + l*l)/12.0}"
        ixy="0.0"
        ixz="0.0"
        iyz="0.0"
        />
    </inertial>
  </xacro:macro>

  <xacro:macro name="inertial_sphere" params="mass r">
    <inertial>
      <mass value="${mass}"/>
      <inertia
        ixx="${0.4*mass*r*r}"
        iyy="${0.4*mass*r*r}"
        izz="${0.4*mass*r*r}"
        ixy="0.0"
        ixz="0.0"
        iyz="0.0"
        />
    </inertial>
  </xacro:macro>

  <!-- ===================== Base Link 底盘本体 ===================== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.5 0.4 0.1"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 0.8 0.8"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.5 0.4 0.1"/>
      </geometry>
    </collision>

    <xacro:inertial_box mass="10.0" w="0.5" h="0.4" d="0.1"/>
  </link>

  <!-- ===================== 前驱动轮：左 ===================== -->
  <!-- 驱动轮用 continuous：连续旋转、无角度上下限 -->
  <!-- 不要写 revolute：URDF 规范里 revolute 的 <limit> 必须带 lower/upper，
       缺省会被当成 0，轮子有被锁死的风险 -->
  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_left_wheel"/>
    <!-- 驱动轮轴心必须落在 base_link 原点（x=0）上！
         差速驱动的瞬时旋转中心（ICR）就在驱动轮轴线上。轴心偏离 base_link
         时，原地转向会让 base_link 绕轴心画圆（实测半径 0.150m，正是原来的
         x=0.15），于是 odom 位移方向与车头夹角 ≈ 90°。AMCL 的差速运动模型
         把 delta_rot1 算成 -(90° - dyaw/2)，它的噪声项
             delta_rot1_noise = min(|rot1|, |rot1 - pi|) ≈ pi/2
         与步长无关，于是每帧注入
             sigma_trans = sqrt(a3*d^2 + 2*a4*(pi/2)^2) ≈ 0.47 m
         而真实位移只有 0.03 m —— 噪声是信号的 15 倍，粒子云直接炸开。
         这是定位漂移的根因。 -->
    <origin xyz="0.0 0.2 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="1000" velocity="10"/>
  </joint>

  <link name="front_left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.05"/>
      </geometry>
      <material name="black">
        <color rgba="0 0 0 0.9"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.05"/>
      </geometry>
    </collision>
    <xacro:inertial_cylinder mass="0.5" r="0.05" l="0.05"/>
  </link>

  <!-- ===================== 前驱动轮：右 ===================== -->
  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_right_wheel"/>
    <!-- 同 front_left_wheel_joint：轴心必须在 x=0。 -->
    <origin xyz="0.0 -0.2 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="1000" velocity="10"/>
  </joint>

  <link name="front_right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.05"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.05"/>
      </geometry>
    </collision>
    <xacro:inertial_cylinder mass="0.5" r="0.05" l="0.05"/>
  </link>

  <!-- ===================== 后从动脚轮（固定关节，无驱动） ===================== -->
  <!-- 驱动轮搬到 base_link 原点后，脚轮也必须改成"前后各一个、走在中心线上"：
       原来两个脚轮都在 x=-0.15，轴心搬到 0 之后重心正好压在支撑多边形边缘，
       车会向前栽。中心线上的球体脚轮只负责支撑，mu=0.01 近似无摩擦，
       不参与转向、不影响 ICR。 -->
  <joint name="rear_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_caster"/>
    <origin xyz="-0.20 0.0 0.0" rpy="0 0 0"/>
  </joint>

  <link name="rear_caster">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
      <material name="gray">
        <color rgba="0.3 0.3 0.3 0.8"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
    </collision>
    <xacro:inertial_sphere mass="0.2" r="0.05"/>
  </link>

  <!-- ===================== 前从动脚轮 ===================== -->
  <joint name="front_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_caster"/>
    <origin xyz="0.20 0.0 0.0" rpy="0 0 0"/>
  </joint>

  <link name="front_caster">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
    </collision>
    <xacro:inertial_sphere mass="0.2" r="0.05"/>
  </link>

  <!-- ===================== Laser 激光雷达 ===================== -->
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser"/>
    <!-- 原来装在 z=0.18：只比车顶(0.10)高 8cm，正好卡在 GPS 盒(0.185~0.215)
         下方，再叠加当时车体 1.91° 的永久俯仰（驱动轮 r=0.05、脚轮 r=0.04
         不一致导致 atan(0.01/0.30)），扫描平面会擦到自身结构，打出
         0.26~0.55m 的近距离回波。抬到 0.26：向后 0.5m 处平面仍有
         0.243 > GPS 盒顶 0.215。
         注：脚轮半径已改为 0.05 与驱动轮齐平，上面那个 1.91° 俯仰已经
         消失；这里保持 0.26 不动，纯粹为了留足余量。 -->
    <origin xyz="0.25 0 0.26" rpy="0 0 0"/>
  </joint>
  <link name="laser">
    <visual>
      <geometry>
        <cylinder radius="0.03" length="0.04"/>
      </geometry>
      <material name="red">
        <color rgba="0.9 0.1 0.1 0.8"/>
      </material>
    </visual> 
    <xacro:inertial_cylinder mass="0.1" r="0.03" l="0.04" />
  </link>

  <!-- ===================== IMU ===================== -->
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.0 0 0.12" rpy="0 0 0"/>
  </joint>
  <link name="imu_link">
    <visual>
      <geometry>
        <box size="0.04 0.04 0.02"/>
      </geometry>
      <material name="green">
        <color rgba="0.1 0.9 0.1 0.8"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.04 0.04 0.02"/>
      </geometry>
    </collision>  
    <xacro:inertial_box mass="0.05" w="0.04" h="0.04" d="0.02"/>
  </link>

  <!-- ===================== GPS（预留，固定在底盘上方） ===================== -->
  <joint name="gps_joint" type="fixed">
    <parent link="base_link"/>
    <child link="gps_link"/>
    <origin xyz="0.0 0 0.20" rpy="0 0 0"/>
  </joint>
  <link name="gps_link">
    <visual>
      <geometry>
        <box size="0.05 0.05 0.03"/>
      </geometry>
      <material name="yellow">
        <color rgba="0.9 0.9 0.1 0.8"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.05 0.05 0.03"/>
      </geometry>
    </collision> 
    <xacro:inertial_box mass="0.03" w="0.05" h="0.05" d="0.03"/>
  </link>

  <!-- ===================== Gazebo插件：use_gazebo=true才加载 ===================== -->
  <xacro:if value="$(arg use_gazebo)">
    <!-- 脚轮摩擦设置 ===================================================
         脚轮关节是 fixed，Gazebo 会把子链接"lump"进 base_link，变成
         base_link_fixed_joint_lump__*_caster_collision。
         lump 后它不能滚动、不能转向 —— 本质是一块刚性滑板。实测两个脚轮
         各顶住 42~53N（车重 113.6N），把驱动轮架到刚好离地，左前轮接触力
         40.2N 超过 mu*N=38.85N 打滑，于是 v 只剩 65%、w 只剩 25%。
         解法：碰撞体换成 sphere（各向同性、无"轮缘"卡边），mu 压到 0.01
         近似自由滚动 —— 这是 Gazebo 里做从动脚轮的标准做法。
         半径同时由 0.04 改成 0.05 与驱动轮齐平：原来 r 差 1cm、前后轮距 0.30m
         导致车体恒定俯仰 atan(0.01/0.30)=1.91°（实测 -1.91°，完全吻合）。
         现在前后脚轮都在中心线上、z=0、r=0.05，且驱动轮也在 z=0，仍然齐平。 -->
    <gazebo reference="rear_caster">
      <mu1>0.01</mu1>
      <mu2>0.01</mu2>
      <kp>1000000.0</kp>
      <kd>1.0</kd>
    </gazebo>

    <gazebo reference="front_caster">
      <mu1>0.01</mu1>
      <mu2>0.01</mu2>
      <kp>1000000.0</kp>
      <kd>1.0</kd>
    </gazebo>

    <!-- 差速驱动插件 -->
    <gazebo>
      <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
        <ros>
          <namespace>/</namespace>
          <!-- ROS 原生 `from:=to` remap 语法 -->
	        <!-- 速度指令接收：/cmd_vel -->
          <remapping>cmd_vel:=cmd_vel</remapping>
	        <!-- 轮速里程计输出：/wheel/odom 【重点！不是/odom】 -->
          <remapping>odom:=wheel/odom</remapping>
        </ros>
        
        <left_joint>front_left_wheel_joint</left_joint>
        <right_joint>front_right_wheel_joint</right_joint>
        <wheel_separation>0.4</wheel_separation>
        <wheel_diameter>0.1</wheel_diameter>
        <max_wheel_torque>20</max_wheel_torque>
        <max_wheel_acceleration>1.0</max_wheel_acceleration>
        <update_rate>50</update_rate>
        <!-- 注意：这里插件自带odom frame我们不用！odom->base_link交给robot_localization --> 
        <publish_odom>true</publish_odom>
        <publish_odom_tf>false</publish_odom_tf><!-- ⭐ 关闭插件TF输出！非常重要 -->
        <odometry_frame>odom</odometry_frame>
        <robot_base_frame>base_link</robot_base_frame>
      </plugin>
    </gazebo>

    <!-- 关节状态插件：把两个驱动轮的转角发布到 /joint_states -->
    <!-- 没有它，robot_state_publisher 无法发布 base_link -> front_left_wheel
         / front_right_wheel，RViz RobotModel 会报
         "No transform from [front_left_wheel] to [map]" -->
    <!-- 注意：用了这个插件就不要再去 ros2 run joint_state_publisher，
         否则 /joint_states 会有两个发布者 -->
    <gazebo>
      <plugin name="joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
        <ros>
          <namespace>/</namespace>
        </ros>
        <update_rate>30</update_rate>
        <joint_name>front_left_wheel_joint</joint_name>
        <joint_name>front_right_wheel_joint</joint_name>
      </plugin>
    </gazebo>

    <!-- Laser雷达传感器插件 -->
    <gazebo reference="laser">
      <sensor name="laser" type="ray">
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>20</update_rate>
        <ray>
          <!-- 设置扫描范围 -->
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>0.000000</min_angle>
              <max_angle>6.280000</max_angle>
            </horizontal>
          </scan>
          <!-- 设置扫描距离 -->
          <range>
            <!-- 原来 0.26：打在自车上的射线被 Gazebo 钳位成"0.26m 的真实观测"
                 混进 /scan。抬到 0.55（注意 Gazebo 是把更近的命中钳位到 min，
                 真正的修复是上面把雷达抬高，这里只是兜底）。 -->
            <min>0.55</min>
            <max>8.0</max>
            <resolution>0.05</resolution>
          </range>
          <!-- 设置噪声 -->
          <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.01</stddev>
          </noise>          
        </ray>
        <plugin name="laser" filename="libgazebo_ros_ray_sensor.so">
          <ros>
            <remapping>~/out:=/scan</remapping>
          </ros>
          <output_type>sensor_msgs/LaserScan</output_type>
          <frame_name>laser</frame_name>
        </plugin>
      </sensor>
    </gazebo>

    <!-- IMU传感器插件 -->
    <gazebo reference="imu_link">
      <sensor name="imu" type="imu">
        <plugin name="imu" filename="libgazebo_ros_imu_sensor.so">
          <ros>
            <remapping>~/out:=imu/data</remapping>
          </ros>
          <output_type>sensor_msgs/Imu</output_type>
          <frame_name>imu_link</frame_name>
          <update_rate>100</update_rate>
        </plugin>
      </sensor>
    </gazebo>

    <!-- GPS预留：这里不加传感器插件，只保留link，后续需要再打开 -->
  </xacro:if>

</robot>
